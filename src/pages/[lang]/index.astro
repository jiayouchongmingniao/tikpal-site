---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import type { HomeContent, CommonContent } from '../../components/home/types';
import { LANGS, HOME_LANGS, homePath, localizeContent } from '../../utils/i18n';
import { homeJsonLd } from '../../utils/jsonLd';

import zh from '../../content/home/i18n/zh.json';
import ja from '../../content/home/i18n/ja.json';
import ko from '../../content/home/i18n/ko.json';
import de from '../../content/home/i18n/de.json';
import es from '../../content/home/i18n/es.json';
import it from '../../content/home/i18n/it.json';

import zhCommon from '../../content/common/i18n/zh.json';
import jaCommon from '../../content/common/i18n/ja.json';
import koCommon from '../../content/common/i18n/ko.json';
import deCommon from '../../content/common/i18n/de.json';
import esCommon from '../../content/common/i18n/es.json';
import itCommon from '../../content/common/i18n/it.json';

const locales: Record<string, HomeContent> = {
  zh: zh as HomeContent,
  ja: ja as HomeContent,
  ko: ko as HomeContent,
  de: de as HomeContent,
  es: es as HomeContent,
  it: it as HomeContent,
};

const commonLocales: Record<string, CommonContent> = {
  zh: zhCommon as CommonContent,
  ja: jaCommon as CommonContent,
  ko: koCommon as CommonContent,
  de: deCommon as CommonContent,
  es: esCommon as CommonContent,
  it: itCommon as CommonContent,
};

export function getStaticPaths() {
  return HOME_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const home = localizeContent(locales[lang], lang);

// 7 language alternates + x-default → /
const alternates = [
  ...LANGS.map((l) => ({
    lang: l,
    href: new URL(homePath(l), Astro.site).href,
  })),
  { lang: 'x-default', href: new URL('/', Astro.site).href },
];
---

<BaseLayout
  title={home.meta.title}
  description={home.meta.description}
  lang={lang}
  alternates={alternates}
  currentLang={lang}
  common={commonLocales[lang]}
  footerClosingLine={home.closingLine}
  pageKind="home"
  jsonLd={homeJsonLd(home)}
>
  <HomePage content={home} />
</BaseLayout>
