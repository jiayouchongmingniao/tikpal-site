---
// Cloudflare Pages serves dist/404.html with a real HTTP 404 for unknown
// paths. Kept minimal + standalone (no BaseLayout) so it never depends on
// language state; links point at the language-detecting entries.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — Tikpal</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0a0a0a" />
    <style>
      :root {
        color-scheme: dark;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        display: grid;
        place-items: center;
        background: #0a0a0a;
        color: #faf7f2;
        font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        text-align: center;
      }

      .nf {
        display: grid;
        justify-items: center;
        gap: 1.1rem;
        padding: 2rem;
      }

      .nf-code {
        font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        opacity: 0.55;
      }

      .nf-title {
        font-size: clamp(1.7rem, 4vw, 2.6rem);
        font-weight: 650;
        letter-spacing: -0.03em;
      }

      .nf-body {
        max-width: 30rem;
        font-size: 0.95rem;
        line-height: 1.6;
        opacity: 0.7;
      }

      .nf-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem 1.4rem;
        padding-top: 0.4rem;
      }

      .nf-links a {
        color: #faf7f2;
        text-decoration: none;
        font-size: 0.9rem;
        opacity: 0.85;
        border-bottom: 1px solid rgba(250, 247, 242, 0.35);
        transition: opacity 0.25s ease, border-color 0.25s ease;
      }

      .nf-links a:hover {
        opacity: 1;
        border-color: currentColor;
      }
    </style>
  </head>
  <body>
    <main class="nf">
      <p class="nf-code">Error 404</p>
      <h1 class="nf-title">This page doesn't exist.</h1>
      <p class="nf-body">
        The link may be outdated, or the page may have moved. Everything Tikpal makes starts
        from one place.
      </p>
      <nav class="nf-links">
        <a href="/">Home</a>
        <a href="/voice/">Tikpal Voice</a>
        <a href="/faq/">FAQ</a>
        <a href="/support/">Support</a>
      </nav>
    </main>
  </body>
</html>
