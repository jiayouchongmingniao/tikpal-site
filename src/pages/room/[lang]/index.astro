---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RoomHero from '../../../components/room/RoomHero.astro';
import RoomRoadmap from '../../../components/room/RoomRoadmap.astro';
import RoomStates from '../../../components/room/RoomStates.astro';
import RoomLineup from '../../../components/room/RoomLineup.astro';
import RoomSystems from '../../../components/room/RoomSystems.astro';
import RoomAllInOne from '../../../components/room/RoomAllInOne.astro';
import RoomCta from '../../../components/room/RoomCta.astro';
import type { RoomContent } from '../../../components/room/types';

import en from '../../../content/room/i18n/en.json';
import de from '../../../content/room/i18n/de.json';
import it from '../../../content/room/i18n/it.json';
import ko from '../../../content/room/i18n/ko.json';
import ja from '../../../content/room/i18n/ja.json';
import zh from '../../../content/room/i18n/zh.json';
import es from '../../../content/room/i18n/es.json';

import enCommon from '../../../content/common/i18n/en.json';
import deCommon from '../../../content/common/i18n/de.json';
import itCommon from '../../../content/common/i18n/it.json';
import koCommon from '../../../content/common/i18n/ko.json';
import jaCommon from '../../../content/common/i18n/ja.json';
import zhCommon from '../../../content/common/i18n/zh.json';
import esCommon from '../../../content/common/i18n/es.json';
import type { CommonContent } from '../../../components/home/types';

export const ROOM_LANGS = ['en', 'de', 'it', 'ko', 'ja', 'zh', 'es'] as const;

const locales: Record<string, RoomContent> = {
  en: en as RoomContent,
  de: de as RoomContent,
  it: it as RoomContent,
  ko: ko as RoomContent,
  ja: ja as RoomContent,
  zh: zh as RoomContent,
  es: es as RoomContent,
};

const commonLocales: Record<string, CommonContent> = {
  en: enCommon as CommonContent,
  de: deCommon as CommonContent,
  it: itCommon as CommonContent,
  ko: koCommon as CommonContent,
  ja: jaCommon as CommonContent,
  zh: zhCommon as CommonContent,
  es: esCommon as CommonContent,
};

export function getStaticPaths() {
  return ROOM_LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as string;
const content = locales[lang];

// 7 language alternates + x-default → /room/en/
const alternates = [
  ...ROOM_LANGS.map((l) => ({
    lang: l,
    href: new URL(`/room/${l}/`, Astro.site).href,
  })),
  { lang: 'x-default', href: new URL('/room/en/', Astro.site).href },
];
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  lang={lang}
  alternates={alternates}
  currentLang={lang}
  common={commonLocales[lang]}
  footerClosingLine={content.closingLine}
  pageKind="room"
>
  <RoomHero content={content.hero} />
  <RoomRoadmap content={content.roadmap} />
  <RoomStates content={content.states} />
  <RoomLineup content={content.lineup} />
  <RoomSystems content={content.systems} />
  <RoomAllInOne content={content.allInOne} />
  <RoomCta content={content.cta} />
</BaseLayout>
