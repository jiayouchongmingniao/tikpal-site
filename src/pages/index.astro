---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import type { HomeContent, CommonContent } from '../components/home/types';
import { LANGS, homePath, localizeContent } from '../utils/i18n';
import { homeJsonLd } from '../utils/jsonLd';
import content from '../content/home/i18n/en.json';
import common from '../content/common/i18n/en.json';

const home = localizeContent(content as HomeContent, 'en');

// 7 language alternates + x-default → /
const alternates = [
  ...LANGS.map((l) => ({
    lang: l,
    href: new URL(homePath(l), Astro.site).href,
  })),
  { lang: 'x-default', href: new URL('/', Astro.site).href },
];
---

<BaseLayout
  title={home.meta.title}
  description={home.meta.description}
  lang="en"
  alternates={alternates}
  currentLang="en"
  common={common as CommonContent}
  footerClosingLine={home.closingLine}
  pageKind="home"
  jsonLd={homeJsonLd(home)}
>
  <HomePage content={home} />
</BaseLayout>
