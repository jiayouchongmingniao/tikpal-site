---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticlePage from '../../components/ArticlePage.astro';
import type { ArticleContent } from '../../components/ArticlePage.astro';
import type { CommonContent } from '../../components/home/types';
import { LANGS, pagePath } from '../../utils/i18n';

import en from '../../content/support/i18n/en.json';
import enCommon from '../../content/common/i18n/en.json';

const content = en as ArticleContent;

// 7 language alternates + x-default → /support/
const alternates = [
  ...LANGS.map((l) => ({
    lang: l,
    href: new URL(pagePath('support', l), Astro.site).href,
  })),
  { lang: 'x-default', href: new URL('/support/', Astro.site).href },
];
---

<BaseLayout
  title={content.meta.title}
  description={content.meta.description}
  lang="en"
  alternates={alternates}
  currentLang="en"
  common={enCommon as CommonContent}
  pageKind="support"
>
  <ArticlePage content={content} />
</BaseLayout>
