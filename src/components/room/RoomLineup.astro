---
import type { RoomLineup } from './types';

interface Props {
  content: RoomLineup;
}

const { content } = Astro.props;

// bump on lineup image replacement to bust 7-day browser cache
const IMG_VER = 'v2';
const cacheBust = (src: string) => `${src}?${IMG_VER}`;
---

<section id="lineup" class="lineup section surface-room grain">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow mono">Tikpal Room line</p>
      <h2 class="h2">{content.title}</h2>
      <p class="lead">{content.subtitle}</p>
    </header>

    <div class="lineup-grid">
      {
        content.items.map((tier, i) => (
          <article
            class="tier reveal"
            style={`--reveal-delay: ${i * 0.14}s`}
          >
            <div class="tier-art">
              <picture>
                <source type="image/avif" srcset={cacheBust(tier.image.replace(/\.webp$/, '.avif'))} />
                <img
                  src={cacheBust(tier.image)}
                  alt={tier.name}
                  width="1024"
                  height="1024"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
              <span class="tier-distance mono">{tier.distance}</span>
            </div>

            <div class="tier-body">
              <h3 class="tier-name">{tier.name}</h3>
              <p class="tier-line">“{tier.tagline}”</p>
              <ul class="tier-specs">
                {tier.specs.map((spec) => (
                  <li class="tier-spec mono">{spec}</li>
                ))}
              </ul>
              <p class="tier-best mono">{tier.best}</p>
            </div>
          </article>
        ))
      }
    </div>

    <p class="lineup-cta reveal">
      <a class="link-arrow" href="https://room.tikpal.ai" target="_blank" rel="noopener">
        {content.cta}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    align-items: start;
  }

  .tier {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: rgba(250, 247, 242, 0.03);
    transition: transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) ease;
  }

  .tier:hover {
    transform: translateY(-6px);
    border-color: rgba(250, 247, 242, 0.3);
  }

  /* distance progression: cards descend like seating positions */
  .tier:nth-child(2) {
    margin-top: clamp(0rem, 3vw, 2.5rem);
  }

  .tier:nth-child(3) {
    margin-top: clamp(0rem, 6vw, 5rem);
  }

  .tier-art {
    position: relative;
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: var(--tone-800);
  }

  .tier-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tier-distance {
    position: absolute;
    left: 0.8rem;
    bottom: 0.8rem;
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: rgba(10, 10, 10, 0.72);
    border: 1px solid var(--line-light);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .tier-body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: 0 var(--space-1) var(--space-1);
  }

  .tier-name {
    font-size: var(--text-h4);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .tier-line {
    font-size: var(--text-body);
    opacity: 0.75;
  }

  .tier-specs {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: var(--space-1);
  }

  .tier-spec {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-pill);
    font-size: var(--text-micro);
    opacity: 0.75;
    letter-spacing: 0.04em;
  }

  .tier-best {
    margin-top: var(--space-1);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--amber);
    opacity: 0.9;
  }

  .lineup-cta {
    margin-top: var(--space-5);
    display: flex;
    justify-content: center;
  }

  .lineup-cta .link-arrow {
    font-size: var(--text-body);
  }

  @media (max-width: 860px) {
    .lineup-grid {
      grid-template-columns: 1fr;
    }

    .tier:nth-child(2),
    .tier:nth-child(3) {
      margin-top: 0;
    }
  }
</style>
