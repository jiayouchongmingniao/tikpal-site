---
import footer from '../content/footer.json';

const icons: Record<string, string> = {
  Instagram:
    'M12 2.2c2.7 0 3 0 4.1.1 1 0 1.6.2 2 .4.5.2.8.4 1.2.8.4.4.6.7.8 1.2.2.4.4 1 .4 2 .1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1-.2 1.6-.4 2-.2.5-.4.8-.8 1.2-.4.4-.7.6-1.2.8-.4.2-1 .4-2 .4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1 0-1.6-.2-2-.4-.5-.2-.8-.4-1.2-.8-.4-.4-.6-.7-.8-1.2-.2-.4-.4-1-.4-2-.1-1.1-.1-1.4-.1-4.1s0-3 .1-4.1c0-1 .2-1.6.4-2 .2-.5.4-.8.8-1.2.4-.4.7-.6 1.2-.8.4-.2 1-.4 2-.4 1.1-.1 1.4-.1 4.1-.1zm0 4.6a5.2 5.2 0 1 0 0 10.4 5.2 5.2 0 0 0 0-10.4zm0 8.6a3.4 3.4 0 1 1 0-6.8 3.4 3.4 0 0 1 0 6.8zm6.6-8.8a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z',
  X: 'M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L1.4 2h6.4l4.4 5.9L18.9 2zm-1.1 18.1h1.7L7 3.8H5.2l12.6 16.3z',
  YouTube:
    'M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.5 15.6V8.4L15.8 12l-6.3 3.6z',
  TikTok:
    'M16.6 2h-3.1v13.3a2.9 2.9 0 1 1-2.9-2.9c.2 0 .5 0 .7.1V9.3a6.2 6.2 0 0 0-.7 0 6.1 6.1 0 1 0 6.1 6.1V8.7a7.4 7.4 0 0 0 4.3 1.4V7a4.4 4.4 0 0 1-4.4-4.4V2z',
};
---

<footer class="site-footer surface-dark grain">
  <div class="container">
    <p class="footer-closing reveal">{footer.closingLine}</p>

    <div class="footer-grid">
      {
        footer.columns.map((col) => (
          <div class="footer-col">
            <h3 class="footer-title">{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer-col footer-social-col">
        <h3 class="footer-title">Follow</h3>
        <ul class="footer-socials">
          {footer.socials.map((social) => (
            <li>
              <a href={social.href} aria-label={social.name} title={social.name}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d={icons[social.name]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="footer-copy mono">{footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 0 var(--space-4);
    color: var(--white);
  }

  .footer-closing {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-5);
    max-width: 16em;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-light);
  }

  .footer-title {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    opacity: 0.55;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .footer-col ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .footer-col a {
    font-size: var(--text-small);
    opacity: 0.8;
    transition: opacity var(--dur-fast) ease;
  }

  .footer-col a:hover {
    opacity: 1;
  }

  .footer-socials {
    display: flex !important;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-out);
  }

  .footer-socials a:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer-copy {
    margin-top: var(--space-4);
    opacity: 0.55;
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
