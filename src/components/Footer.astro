---

<footer class="site-footer surface-dark grain">
  <div class="container">
    <p class="footer-closing reveal">{footer.closingLine}</p>

    <div class="footer-grid">
      {
        footer.columns.map((col) => (
          <div class="footer-col">
            <h3 class="footer-title">{col.title}</h3>
            <ul>
              {col.links.map((link) => (
                <li>
                  <a href={localizeHref(link.href, lang)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer-col footer-social-col">
        <h3 class="footer-title">Follow</h3>
        <ul class="footer-socials">
          {footer.socials.map((social) => (
            <li>
              <a href={social.href} aria-label={social.name} title={social.name}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                  <path d={icons[social.name]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="footer-copy mono">{footer.copyright}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: var(--space-6) 0 var(--space-4);
    color: var(--white);
  }

  .footer-closing {
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    margin-bottom: var(--space-5);
    max-width: 16em;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--line-light);
  }

  .footer-title {
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    opacity: 0.55;
    margin-bottom: var(--space-2);
    font-weight: 600;
  }

  .footer-col ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .footer-col a {
    font-size: var(--text-small);
    opacity: 0.8;
    transition: opacity var(--dur-fast) ease;
  }

  .footer-col a:hover {
    opacity: 1;
  }

  .footer-socials {
    display: flex !important;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .footer-socials a {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    opacity: 0.75;
    transition: opacity var(--dur-fast) ease,
      transform var(--dur-fast) var(--ease-out);
  }

  .footer-socials a:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .footer-copy {
    margin-top: var(--space-4);
    opacity: 0.55;
  }

  @media (max-width: 960px) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
