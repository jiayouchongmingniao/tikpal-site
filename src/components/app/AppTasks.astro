---
import type { AppTasks } from './types';

interface Props {
  content: AppTasks;
}

const { content } = Astro.props;
---

<section class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{content.title}</h2>
      <p class="lead">{content.subtitle}</p>
    </header>

    <div class="at-grid">
      {
        content.points.map((point, i) => (
          <article class="at-card reveal" style={`--reveal-delay: ${i * 0.12}s`}>
            <p class="at-step mono">0{i + 1}</p>
            <h3 class="at-name">{point.name}</h3>
            <p class="at-detail">{point.detail}</p>
          </article>
        ))
      }
    </div>

    <p class="at-examples mono reveal">{content.examples}</p>
  </div>
</section>

<style>
  .at-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .at-card {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: var(--space-3) 1.2rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-m);
    background: rgba(250, 247, 242, 0.055);
    min-height: 9rem;
  }

  .at-step {
    opacity: 0.5;
    letter-spacing: 0.12em;
  }

  .at-name {
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .at-detail {
    font-size: var(--text-small);
    line-height: 1.55;
    opacity: 0.85;
  }

  .at-examples {
    margin-top: var(--space-4);
    text-align: center;
    opacity: 0.55;
  }

  @media (max-width: 860px) {
    .at-grid {
      grid-template-columns: 1fr;
    }

    .at-card {
      min-height: 0;
    }
  }
</style>
