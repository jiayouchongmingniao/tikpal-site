---
import type { AppDevices } from './types';

interface Props {
  content: AppDevices;
}

const { content } = Astro.props;

const IMG_VER = '?v3';
const src = content.multiDevice.src + IMG_VER;
---

<section class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{content.title}</h2>
    </header>

    <figure class="devices-figure reveal">
      <picture>
        <source
          type="image/avif"
          srcset={content.multiDevice.src.replace(/\.webp$/, '.avif') + IMG_VER}
        />
        <img
          src={src}
          alt={content.multiDevice.alt}
          width="1530"
          height="596"
          loading="lazy"
          decoding="async"
        />
      </picture>
    </figure>

    <div class="devices-actions reveal">
      {
        content.actions.map((action, i) => (
          <p class="devices-action">
            <span class="devices-action-index mono">
              {String(i + 1).padStart(2, '0')}
            </span>
            {action}
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  .devices-figure {
    margin: 0 auto;
    max-width: 52rem;
  }

  .devices-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--line-light);
  }

  .devices-actions {
    margin-top: var(--space-4);
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }

  .devices-action {
    display: grid;
    gap: 0.3rem;
    text-align: center;
    font-size: var(--text-h4);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .devices-action-index {
    opacity: 0.4;
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
  }

  @media (max-width: 860px) {
    .devices-actions {
      flex-direction: column;
      align-items: center;
      gap: 0.8rem;
    }
  }
</style>
