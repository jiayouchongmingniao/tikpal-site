---
import type { AppHero } from './types';

interface Props {
  content: AppHero;
  // Shared with the closing AppCta block — same external app destination.
  ctaHref: string;
}

const { content, ctaHref } = Astro.props;
---

<section class="hero section surface-dark grain">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-inner">
    <p class="eyebrow mono app-eyebrow reveal">
      <picture>
        <source type="image/avif" srcset="/images/app/app-icon.avif" />
        <img
          class="app-icon"
          src="/images/app/app-icon.webp"
          alt="Tikpal app icon"
          width="256"
          height="256"
          loading="eager"
          decoding="async"
        />
      </picture>
      {content.eyebrow}
    </p>
    <h1 class="h1 reveal" style="--reveal-delay: 0.1s">{content.headline}</h1>
    <p class="lead reveal" style="--reveal-delay: 0.2s">{content.subtitle}</p>
    <div class="hero-actions reveal" style="--reveal-delay: 0.3s">
      <a class="btn btn-solid" href={ctaHref} target="_blank" rel="noopener">
        {content.primaryCta}
        <span aria-hidden="true">→</span>
      </a>
      {
        content.downloads.map((d) => (
          <a class="hero-download mono" href={d.href} target="_blank" rel="noopener">
            {d.label}
          </a>
        ))
      }
    </div>
    <p class="hero-status mono reveal" style="--reveal-delay: 0.4s">
      {content.statusLine}
    </p>
  </div>
</section>

<style>
  .hero {
    min-height: 92svh;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(4rem, 3rem + 6vw, 7rem);
    position: relative;
    overflow: hidden;
  }

  .hero-glow {
    position: absolute;
    left: -12%;
    bottom: -20%;
    width: 48vw;
    height: 48vw;
    max-width: 40rem;
    max-height: 40rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--amber-soft) 0%,
      rgba(201, 138, 75, 0.05) 45%,
      transparent 70%
    );
    animation: drift 14s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    display: grid;
    gap: var(--space-2);
    align-content: end;
    max-width: var(--container);
  }

  .hero-inner .h1 {
    max-width: 14em;
  }

  .hero-inner .lead {
    max-width: 34em;
  }

  .app-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .app-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .hero-download {
    font-size: var(--text-small);
    opacity: 0.62;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    transition: opacity var(--dur-fast) ease;
  }

  .hero-download:hover {
    opacity: 1;
  }

  .hero-status {
    margin-top: var(--space-2);
    font-size: var(--text-small);
    letter-spacing: 0.06em;
    opacity: 0.9;
    max-width: 46em;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 0;
      padding-top: calc(var(--section-pad) + 2rem);
    }
  }
</style>
