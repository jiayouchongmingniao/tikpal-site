---
import type { CommonNav } from './home/types';
import { LANGS, localizeHref, pagePath } from '../utils/i18n';

interface Props {
  nav: CommonNav;
  currentLang?: string;
  // Which site area renders the language switcher targets:
  // 'home' switches between / and /{lang}/, 'room' between /room/{lang}/,
  // 'app' between /app/{lang}/,
  // article pages ('privacy' | 'terms' | 'about' | 'support' | 'faq') between /{kind}/ and /{lang}/{kind}/.
  pageKind?: string;
}

const { nav, currentLang, pageKind = 'home' } = Astro.props;
const lang = currentLang ?? 'en';

const langLinks = LANGS.map((code) => ({
  code,
  label: code.toUpperCase(),
  href: pagePath(pageKind, code),
}));
---

<header class="site-header">
  <nav class="nav container" aria-label="Primary">
    <a class="brand" href={localizeHref('/', lang)}>
      <picture>
        <source type="image/avif" srcset={nav.logo.src.replace(/\.webp$/, '.avif')} />
        <img
          class="brand-logo"
          src={nav.logo.src}
          alt={nav.logo.alt}
          width="600"
          height="249"
          loading="eager"
          decoding="async"
        />
      </picture>
    </a>

    <ul class="nav-links">
      {
        nav.links.map((link) => (
          <li>
            <a href={localizeHref(link.href, lang)}>{link.label}</a>
          </li>
        ))
      }
    </ul>

    {
      currentLang && (
        <ul class="lang-switch mono" aria-label="Language">
          {langLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class={l.code === currentLang ? 'is-active' : ''}
                aria-current={l.code === currentLang ? 'page' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <a class="nav-shop" href={localizeHref(nav.shop.href, lang)}>
      {nav.shop.label}
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      onclick="toggleMenu()"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </nav>

  <div class="mobile-menu" id="mobile-menu">
    <ul>
      {
        nav.links.map((link) => (
          <li>
            <a href={localizeHref(link.href, lang)} onclick="toggleMenu(false)">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="mobile-shop"
          href={localizeHref(nav.shop.href, lang)}
          onclick="toggleMenu(false)">{nav.shop.label}</a
        >
      </li>
      {
        currentLang && (
          <li class="mobile-lang">
            <ul class="lang-switch mono" aria-label="Language">
              {langLinks.map((l) => (
                <li>
                  <a
                    href={l.href}
                    class={l.code === currentLang ? 'is-active' : ''}
                    aria-current={l.code === currentLang ? 'page' : undefined}
                    onclick="toggleMenu(false)"
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        )
      }
    </ul>
  </div>

  <script is:inline>
    // Single source of truth for the mobile menu state: the toggle button
    // and every menu link call this, so aria-expanded / aria-label always reset.
    function toggleMenu(force) {
      var menu = document.getElementById('mobile-menu');
      var btn = document.querySelector('.nav-toggle');
      var open = force === undefined ? !menu.classList.contains('open') : force;
      menu.classList.toggle('open', open);
      // Inline max-height: highest possible CSS origin, so no stylesheet rule
      // (scoped or not) can ever override it. Measured from real content —
      // always fits, whatever the menu holds (nav + shop + lang switcher).
      // The CSS keeps the max-height transition; reduced-motion users get an
      // instant toggle via the global transition-duration override.
      menu.style.maxHeight = open ? menu.scrollHeight + 'px' : '0px';
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle('menu-open', open);
    }
  </script>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    background: rgba(10, 10, 10, 0.92);
    border-bottom: 1px solid var(--line-light);
    color: var(--white);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    height: 4rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
  }

  .brand-logo {
    height: 26px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.4rem);
    list-style: none;
  }

  .nav-links a {
    font-size: var(--text-small);
    opacity: 0.72;
    transition: opacity var(--dur-fast) ease;
  }

  .nav-links a:hover {
    opacity: 1;
  }

  .nav-shop {
    font-size: var(--text-small);
    font-weight: 600;
    padding: 0.45rem 1.2rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-pill);
    transition: background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .nav-shop:hover {
    background: var(--white);
    color: var(--black);
  }

  /* language switcher — mono technical codes, warm minimal */
  .lang-switch {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    padding: 0.25rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-pill);
  }

  .lang-switch a {
    display: block;
    padding: 0.3rem 0.5rem;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    opacity: 0.5;
    border-radius: var(--radius-pill);
    transition: opacity var(--dur-fast) ease,
      background-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }

  .lang-switch a:hover {
    opacity: 1;
  }

  .lang-switch a.is-active {
    opacity: 1;
    background: var(--amber-soft);
    color: var(--amber);
  }

  .mobile-lang {
    padding-top: var(--space-1);
  }

  .mobile-lang .lang-switch {
    width: 100%;
    flex-wrap: wrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 0.5rem;
  }

  .nav-toggle-bar {
    width: 22px;
    height: 1.5px;
    background: var(--white);
    transition: transform var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) ease;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 860px) {
    .nav-links,
    .nav-shop,
    nav > .lang-switch {
      display: none;
    }

    .nav-toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
      overflow: hidden;
      max-height: 0;
      visibility: hidden;
      transition: max-height var(--dur-med) var(--ease-out),
        visibility 0s linear var(--dur-med);
    }

    .mobile-menu.open {
      /* height itself is set inline by toggleMenu() — see the script above;
         this rule only restores visibility without the hide delay */
      visibility: visible;
      transition: max-height var(--dur-med) var(--ease-out),
        visibility 0s;
    }

    .mobile-menu ul {
      list-style: none;
      padding: var(--space-2) var(--gutter) var(--space-3);
      display: grid;
      gap: 0.25rem;
    }

    .mobile-menu a {
      display: block;
      padding: 0.7rem 0;
      font-size: var(--text-lead);
      font-weight: 600;
      opacity: 0.85;
    }

    /* higher specificity than .mobile-menu a above, so the language chips
       keep their compact style instead of inheriting the big menu links */
    .mobile-menu .lang-switch a {
      padding: 0.3rem 0.5rem;
      font-size: var(--text-micro);
      font-weight: 400;
    }

    /* .mobile-menu ul also matches the pill itself — restore its flex row */
    .mobile-menu .lang-switch {
      display: flex;
      gap: 0.15rem;
      padding: 0.25rem;
    }

    .mobile-menu .mobile-shop {
      margin-top: var(--space-2);
      padding: 0.7rem 1.4rem;
      border: 1px solid var(--line-light);
      border-radius: var(--radius-pill);
      width: fit-content;
      font-size: var(--text-body);
    }
  }
</style>
