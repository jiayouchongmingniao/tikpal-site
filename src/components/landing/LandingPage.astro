---
import type { LandingPageContent, LandingSection } from './types';

interface Props {
  content: LandingPageContent;
  // Localized label for the breadcrumb root (e.g. "Home" / "首页").
  homeLabel: string;
  homeHref: string;
}

const { content, homeLabel, homeHref } = Astro.props;
const { crumbs, hero, sections, faq, finalCta } = content;

// Alternate dark/warm surfaces; hero is always dark.
const surface = (i: number) => (i % 2 === 0 ? 'surface-warm' : 'surface-dark grain');
---

<!-- Visible breadcrumb (mirrored by BreadcrumbList schema) -->
<nav class="lp-crumbbar" aria-label="Breadcrumb">
  <ol class="lp-crumbs mono">
    <li><a href={homeHref}>{homeLabel}</a></li>
    {
      crumbs.map((c, i) => (
        <li>
          <span class="lp-crumb-sep" aria-hidden="true">/</span>
          {i === crumbs.length - 1 || !c.href ? (
            <span class="lp-crumb-current" aria-current={i === crumbs.length - 1 ? 'page' : undefined}>
              {c.label}
            </span>
          ) : (
            <a href={c.href}>{c.label}</a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<!-- SEO hero -->
<section class="lp-hero section surface-dark grain">
  <div class="container lp-hero-copy">
    <p class="eyebrow mono reveal">{hero.eyebrow}</p>
    <h1 class="lp-title reveal" style="--reveal-delay: 0.08s">{hero.title}</h1>
    <p class="lead reveal" style="--reveal-delay: 0.16s">{hero.subtitle}</p>
    <div class="lp-actions reveal" style="--reveal-delay: 0.24s">
      <a class="btn btn-solid" href={hero.primaryCta.href} target="_blank" rel="noopener">
        {hero.primaryCta.label}
      </a>
    </div>
    {hero.trustLine && <p class="lp-trust mono reveal" style="--reveal-delay: 0.3s">{hero.trustLine}</p>}
  </div>
</section>

{
  sections.map((section, i) => (
    <section class={`section ${surface(i)}`}>
      <div class="container">
        {section.kind === 'flow' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            {section.intro && <p class="lp-intro reveal">{section.intro}</p>}
            <div class="lp-flow">
              <p class="lp-flow-from reveal">{section.from}</p>
              <p class="lp-flow-arrow reveal" aria-hidden="true">↓</p>
              <div class="lp-flow-steps">
                {
                  section.steps.map((step, j) => (
                    <span
                      class="lp-flow-step mono reveal"
                      style={`--reveal-delay: ${0.08 * (j + 1)}s`}
                    >
                      {step}
                    </span>
                  ))
                }
              </div>
            </div>
          </>
        )}

        {section.kind === 'points' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            {section.intro && <p class="lp-intro reveal">{section.intro}</p>}
            <ul class="lp-points">
              {
                section.points.map((point, j) => (
                  <li class="lp-point reveal" style={`--reveal-delay: ${0.08 * j}s`}>
                    <span class="lp-check" aria-hidden="true">✓</span> {point}
                  </li>
                ))
              }
            </ul>
          </>
        )}

        {section.kind === 'chips' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            {section.intro && <p class="lp-intro reveal">{section.intro}</p>}
            <div class="lp-chips">
              {
                section.chips.map((chip, j) => (
                  <span class="lp-chip mono reveal" style={`--reveal-delay: ${0.08 * j}s`}>
                    {chip}
                  </span>
                ))
              }
            </div>
            {section.note && <p class="lp-note reveal">{section.note}</p>}
          </>
        )}

        {section.kind === 'quote' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            <div class="lp-quote-card reveal">
              <p class="lp-quote-text">“{section.quote}”</p>
              <p class="lp-quote-arrow" aria-hidden="true">↓</p>
              <p class="lp-quote-result">{section.result}</p>
              {section.note && <p class="lp-quote-note">{section.note}</p>}
            </div>
          </>
        )}

        {section.kind === 'scenes' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            {section.intro && <p class="lp-intro reveal">{section.intro}</p>}
            <div class="lp-scenes">
              {
                section.items.map((item, j) => (
                  <article class="lp-scene reveal" style={`--reveal-delay: ${0.07 * j}s`}>
                    <h3 class="lp-scene-name">{item.name}</h3>
                    <p class="lp-scene-body">{item.body}</p>
                  </article>
                ))
              }
            </div>
          </>
        )}

        {section.kind === 'table' && (
          <>
            <header class="section-head lp-head-center reveal">
              <h2 class="h2">{section.title}</h2>
            </header>
            {section.intro && <p class="lp-table-intro reveal">{section.intro}</p>}
            <div class="lp-table reveal">
              <div
                class="lp-table-row lp-table-head"
                style={`grid-template-columns: 1fr repeat(${section.cols.length}, 1.4fr)`}
              >
                <span class="lp-table-label"></span>
                {section.cols.map((col, j) => (
                  <span class={`lp-table-cell ${j === 0 ? 'lp-first' : 'lp-rest'}`}>{col}</span>
                ))}
              </div>
              {
                section.rows.map((row, j) => (
                  <div
                    class="lp-table-row reveal"
                    style={`grid-template-columns: 1fr repeat(${section.cols.length}, 1.4fr); --reveal-delay: ${0.06 * (j + 1)}s`}
                  >
                    <span class="lp-table-label">{row.label}</span>
                    {row.values.map((val, k) => (
                      <span class={`lp-table-cell ${k === 0 ? 'lp-first' : 'lp-rest'}`}>{val}</span>
                    ))}
                  </div>
                ))
              }
            </div>
          </>
        )}
      </div>
    </section>
  ))
}

{
  faq && (
    <section class={`section ${surface(sections.length)}`}>
      <div class="container lp-faq-wrap">
        <header class="section-head reveal">
          <h2 class="h2">{faq.title}</h2>
        </header>
        <div class="lp-faq">
          {faq.items.map((item, i) => (
            <details class="lp-faq-item reveal" style={`--reveal-delay: ${i * 0.06}s`}>
              <summary class="lp-faq-q">{item.q}</summary>
              <p class="lp-faq-a">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

<!-- Final CTA -->
<section class="section surface-dark grain">
  <div class="container lp-cta reveal">
    <h2 class="h2">{finalCta.title}</h2>
    <a class="btn btn-solid" href={finalCta.button.href} target="_blank" rel="noopener">
      {finalCta.button.label}
    </a>
    {
      finalCta.learnMore && (
        <a class="link-arrow lp-learn" href={finalCta.learnMore.href}>
          {finalCta.learnMore.label}
        </a>
      )
    }
  </div>
</section>

<style>
  .lp-crumbbar {
    position: relative;
    z-index: 2;
    padding: 5.4rem 1.4rem 0;
    background: #0a0a0a;
  }

  .lp-crumbs {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    font-size: var(--text-micro);
    letter-spacing: 0.08em;
    color: rgba(250, 247, 242, 0.6);
  }

  .lp-crumbs a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .lp-crumbs a:hover {
    color: rgba(250, 247, 242, 0.95);
    border-color: currentColor;
  }

  .lp-crumb-sep {
    opacity: 0.4;
    margin-right: 0.55rem;
  }

  .lp-crumb-current {
    color: rgba(250, 247, 242, 0.9);
  }

  .lp-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: var(--space-3);
  }

  .lp-hero-copy {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .lp-title {
    max-width: 46rem;
    font-size: clamp(2rem, 1.1rem + 2.4vw, 3.2rem);
    line-height: 1.12;
    letter-spacing: var(--tracking-tight);
  }

  .lp-hero-copy .lead {
    max-width: 40rem;
  }

  .lp-actions {
    margin-top: var(--space-2);
  }

  .lp-trust {
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    opacity: 0.75;
  }

  .lp-intro {
    max-width: 44rem;
    margin: var(--space-2) auto 0;
    text-align: center;
    font-size: var(--text-small);
    line-height: 1.6;
    opacity: 0.75;
  }

  .lp-head-center {
    text-align: center;
  }

  /* flow: one voice note branching into outcomes */
  .lp-flow {
    max-width: 56rem;
    margin: var(--space-3) auto 0;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
  }

  .lp-flow-from {
    padding: 0.9rem 1.6rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-m);
    font-weight: 600;
    font-size: var(--text-small);
  }

  .lp-flow-arrow {
    opacity: 0.45;
    font-size: var(--text-lead);
  }

  .lp-flow-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .lp-flow-step {
    padding: 0.55rem 1.2rem;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: var(--text-small);
    letter-spacing: 0.05em;
  }

  /* chips */
  .lp-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .lp-chip {
    padding: 0.55rem 1.2rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--text-small);
    letter-spacing: 0.05em;
    opacity: 0.9;
  }

  .lp-note {
    margin-top: var(--space-3);
    text-align: center;
    font-size: var(--text-small);
    opacity: 0.6;
  }

  /* points */
  .lp-points {
    max-width: 44rem;
    margin: var(--space-3) auto 0;
    display: grid;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
  }

  .lp-point {
    font-size: var(--text-small);
    line-height: 1.6;
    opacity: 0.85;
  }

  .lp-check {
    color: var(--tone-400);
  }

  /* quote: spoken example → outcome */
  .lp-quote-card {
    max-width: 40rem;
    margin: var(--space-3) auto 0;
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3) 1.4rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-m);
    text-align: center;
  }

  .lp-quote-text {
    font-size: var(--text-lead);
    line-height: 1.5;
    font-weight: 550;
  }

  .lp-quote-arrow {
    opacity: 0.45;
  }

  .lp-quote-result {
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.05em;
    opacity: 0.85;
  }

  .lp-quote-note {
    font-size: var(--text-micro);
    opacity: 0.55;
  }

  /* scenes grid */
  .lp-scenes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-2);
    margin-top: var(--space-3);
  }

  .lp-scene {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: var(--space-2) 1.1rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-m);
  }

  .lp-scene-name {
    font-weight: 600;
    font-size: var(--text-small);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lp-scene-body {
    font-size: var(--text-small);
    line-height: 1.55;
    opacity: 0.78;
  }

  /* table */
  .lp-table {
    max-width: 56rem;
    margin: var(--space-3) auto 0;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .lp-table-row {
    display: grid;
    grid-template-columns: 1fr 1.4fr 1.4fr;
    gap: var(--space-2);
    padding: 0.9rem 1.1rem;
    border-top: 1px solid var(--line-dark);
    align-items: baseline;
  }

  .lp-table-head {
    border-top: none;
    background: rgba(10, 10, 10, 0.05);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    letter-spacing: 0.05em;
  }

  .lp-table-label {
    font-weight: 600;
    font-size: var(--text-small);
  }

  .lp-table-cell {
    font-size: var(--text-small);
    line-height: 1.5;
  }

  .lp-table-cell.lp-first {
    font-weight: 500;
  }

  .lp-table-cell.lp-rest {
    opacity: 0.72;
  }

  .lp-table-intro {
    max-width: 56rem;
    margin: var(--space-2) auto 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  /* FAQ */
  .lp-faq-wrap {
    max-width: 46rem;
  }

  .lp-faq-item {
    border-top: 1px solid var(--line-dark);
    padding: var(--space-2) 0;
  }

  .lp-faq-item:last-child {
    border-bottom: 1px solid var(--line-dark);
  }

  .lp-faq-q {
    cursor: pointer;
    font-weight: 550;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .lp-faq-q::-webkit-details-marker {
    display: none;
  }

  .lp-faq-q::after {
    content: '+';
    opacity: 0.5;
    transition: transform 0.25s ease;
  }

  .lp-faq-item[open] .lp-faq-q::after {
    transform: rotate(45deg);
  }

  .lp-faq-a {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    line-height: 1.6;
    opacity: 0.75;
  }

  /* final CTA */
  .lp-cta {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .lp-learn {
    font-size: var(--text-small);
  }

  @media (max-width: 860px) {
    .lp-crumbbar {
      padding-top: 6rem;
    }

    .lp-table-row {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }

    .lp-table-head {
      display: none;
    }
  }
</style>
