---
import type { IntelligenceAsk } from './types';

interface Props {
  content: IntelligenceAsk;
}

const { content } = Astro.props;
---

<section id="ask" class="section surface-room grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{content.title}</h2>
    </header>

    <div class="as-stage reveal">
      <div class="as-you">
        <p class="as-role mono">{content.youLabel}</p>
        <p class="as-question">“{content.question}”</p>
      </div>

      <div class="as-tikpal">
        <p class="as-role as-role-tikpal mono">
          <span class="dot-alive" aria-hidden="true"></span>
          {content.tikpalLabel}
        </p>
        <ul class="as-answers">
          {
            content.answers.map((answer, i) => (
              <li class="as-answer" data-as-answer={i}>
                {answer}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- the same understanding, handed straight to the tools you act in -->
    <ul class="ac-targets reveal" style="--reveal-delay: 0.15s">
      {
        content.targets.map((target, i) => (
          <li class="ac-target" data-ac-target={i}>
            {target}
          </li>
        ))
      }
    </ul>

    <div class="ac-cta reveal" style="--reveal-delay: 0.3s">
      <a class="btn btn-solid" href={content.cta.href}>
        {content.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .as-stage {
    display: grid;
    gap: var(--space-3);
    max-width: 44rem;
  }

  .as-you {
    justify-self: end;
    max-width: 30rem;
    padding: var(--space-3);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    border-bottom-right-radius: var(--radius-s);
    opacity: 0;
  }

  .as-tikpal {
    justify-self: start;
    display: grid;
    gap: var(--space-2);
    max-width: 34rem;
    padding: var(--space-3);
    border: 1px solid rgba(47, 230, 167, 0.22);
    border-radius: var(--radius-l);
    border-bottom-left-radius: var(--radius-s);
    background: rgba(250, 247, 242, 0.045);
    opacity: 0;
  }

  .as-role {
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .as-role-tikpal {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0.7;
  }

  .as-role-tikpal .dot-alive {
    flex: none;
  }

  .as-question {
    font-size: var(--text-lead);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: var(--tracking-tight);
  }

  .as-answers {
    list-style: none;
    display: grid;
    gap: 0.7rem;
    padding: 0;
  }

  .as-answer {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--text-body);
    line-height: 1.55;
    opacity: 0;
  }

  .as-answer::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--alive);
    opacity: 0.75;
  }

  /* question first, then the answer panel, then one line at a time */
  .as-stage.is-visible .as-you {
    animation: as-in 0.6s var(--ease-out) forwards;
  }
  .as-stage.is-visible .as-tikpal {
    animation: as-in 0.6s var(--ease-out) 0.4s forwards;
  }
  .as-stage.is-visible .as-answer[data-as-answer='0'] {
    animation: as-line 0.5s var(--ease-out) 0.75s forwards;
  }
  .as-stage.is-visible .as-answer[data-as-answer='1'] {
    animation: as-line 0.5s var(--ease-out) 1s forwards;
  }
  .as-stage.is-visible .as-answer[data-as-answer='2'] {
    animation: as-line 0.5s var(--ease-out) 1.25s forwards;
  }
  .as-stage.is-visible .as-answer[data-as-answer='3'] {
    animation: as-line 0.5s var(--ease-out) 1.5s forwards;
  }

  @keyframes as-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes as-line {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* the act-half: where the understanding goes next */
  .ac-targets {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-5);
    padding: 0;
  }

  .ac-target {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 1.6rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-pill);
    background: rgba(250, 247, 242, 0.045);
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    opacity: 0;
  }

  /* the arrow lives in CSS, so the JSON stays a clean list of names */
  .ac-target::before {
    content: "→";
    font-weight: 400;
    opacity: 0.45;
  }

  .ac-targets.is-visible .ac-target[data-ac-target='0'] {
    animation: ac-in 0.55s var(--ease-out) forwards;
  }
  .ac-targets.is-visible .ac-target[data-ac-target='1'] {
    animation: ac-in 0.55s var(--ease-out) 0.12s forwards;
  }
  .ac-targets.is-visible .ac-target[data-ac-target='2'] {
    animation: ac-in 0.55s var(--ease-out) 0.24s forwards;
  }
  .ac-targets.is-visible .ac-target[data-ac-target='3'] {
    animation: ac-in 0.55s var(--ease-out) 0.36s forwards;
  }
  .ac-targets.is-visible .ac-target[data-ac-target='4'] {
    animation: ac-in 0.55s var(--ease-out) 0.48s forwards;
  }

  @keyframes ac-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .ac-cta {
    margin-top: var(--space-4);
  }

  @media (prefers-reduced-motion: reduce) {
    .as-you,
    .as-tikpal,
    .as-answer,
    .ac-target {
      animation: none;
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .as-you,
    .as-tikpal {
      justify-self: stretch;
      max-width: none;
    }
  }
</style>
