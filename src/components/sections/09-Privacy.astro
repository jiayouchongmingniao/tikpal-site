---
import type { Trust } from '../home/types';

interface Props {
  content: Trust;
}

const { content: privacy } = Astro.props;
---

<section id="trust" class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{privacy.title}</h2>
      <p class="lead">{privacy.subtitle}</p>
    </header>

    <div class="trust-grid">
      {
        privacy.points.map((point, i) => (
          <article
            class="trust-point reveal"
            style={`--reveal-delay: ${i * 0.12}s`}
          >
            <span class="trust-signal mono">
              {i === 0 && <span class="dot-alive" aria-hidden="true"></span>}
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="trust-name">{point.name}</h3>
            <p class="trust-body">{point.body}</p>
          </article>
        ))
      }
    </div>

    <p class="trust-footnote reveal" style="--reveal-delay: 0.3s">
      {privacy.footnote}
    </p>
  </div>
</section>

<style>
  .trust-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .trust-point {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: rgba(250, 247, 242, 0.03);
    border: 1px solid var(--line-light);
    min-height: 13rem;
  }

  .trust-signal {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    opacity: 0.55;
    letter-spacing: 0.14em;
    margin-bottom: var(--space-2);
  }

  .trust-signal .dot-alive {
    flex: none;
  }

  .trust-name {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .trust-body {
    font-size: var(--text-small);
    opacity: 0.68;
    line-height: 1.6;
  }

  .trust-footnote {
    margin: var(--space-4) auto 0;
    max-width: 36rem;
    text-align: center;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: var(--tracking-tight);
    color: var(--tone-400);
    padding: var(--space-3) 1.4rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: rgba(250, 247, 242, 0.03);
  }

  @media (max-width: 860px) {
    .trust-grid {
      grid-template-columns: 1fr;
    }

    .trust-point {
      min-height: 0;
    }
  }
</style>
