---
import type { HomeDemo } from '../home/types';

interface Props {
  content: HomeDemo;
}

const { content: demo } = Astro.props;

const IMG_VER = '?v3';
---

<section id="demo" class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow mono">{demo.eyebrow}</p>
      <h2 class="h2">{demo.title}</h2>
    </header>

    <div class="demo-stage reveal" style="--reveal-delay: 0.15s">
      <!-- the device -->
      <figure class="demo-device">
        <picture>
          <source type="image/avif" srcset={'/images/screens/screen-voice.avif' + IMG_VER} />
          <img
            src={'/images/screens/screen-voice.webp' + IMG_VER}
            alt="Tikpal Voice on a desk, listening"
            width="700"
            height="467"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="demo-caption mono">
          <span class="dot-alive" aria-hidden="true"></span>
          {demo.deviceCaption}
        </figcaption>
      </figure>

      <span class="demo-arrow" aria-hidden="true">→</span>

      <!-- the words, exactly as spoken -->
      <div class="demo-quote-card">
        <p class="demo-role mono">{demo.quoteLabel}</p>
        <blockquote class="demo-quote">“{demo.quote}”</blockquote>
        <div class="demo-wave" aria-hidden="true">
          <span class="demo-wave-bar" style="height: 8px; animation-delay: 0s"></span>
          <span class="demo-wave-bar" style="height: 18px; animation-delay: 0.12s"></span>
          <span class="demo-wave-bar" style="height: 26px; animation-delay: 0.24s"></span>
          <span class="demo-wave-bar" style="height: 14px; animation-delay: 0.36s"></span>
          <span class="demo-wave-bar" style="height: 30px; animation-delay: 0.48s"></span>
          <span class="demo-wave-bar" style="height: 18px; animation-delay: 0.6s"></span>
          <span class="demo-wave-bar" style="height: 24px; animation-delay: 0.72s"></span>
          <span class="demo-wave-bar" style="height: 10px; animation-delay: 0.84s"></span>
        </div>
      </div>

      <span class="demo-arrow" aria-hidden="true">→</span>

      <!-- what it becomes -->
      <div class="demo-results">
        <p class="demo-role mono">{demo.resultsLabel}</p>
        <ol class="demo-outs">
          {
            demo.outputs.map((out, i) => (
              <li class="demo-out" data-demo-out={i}>
                <span class="demo-out-kind mono">{out.kind}</span>
                <span class="demo-out-text">{out.text}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <p class="demo-flow mono reveal" style="--reveal-delay: 0.3s">{demo.flowLine}</p>
  </div>
</section>

<style>
  .demo-stage {
    display: grid;
    grid-template-columns: minmax(0, 5fr) auto minmax(0, 6fr) auto minmax(0, 6fr);
    gap: var(--space-3);
    align-items: stretch;
  }

  .demo-device {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    margin: 0;
  }

  .demo-device img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
  }

  .demo-caption {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.65;
  }

  .demo-caption .dot-alive {
    flex: none;
  }

  .demo-arrow {
    align-self: center;
    opacity: 0.35;
    font-size: var(--text-h4);
  }

  .demo-quote-card,
  .demo-results {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-3);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: rgba(250, 247, 242, 0.03);
  }

  .demo-role {
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .demo-quote {
    font-size: var(--text-body);
    font-style: italic;
    line-height: 1.6;
    margin: 0;
    padding: 0;
    border: none;
  }

  .demo-wave {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--space-1);
  }

  .demo-wave-bar {
    width: 3px;
    border-radius: 2px;
    background: var(--white);
    opacity: 0.8;
    display: block;
    animation: wave 1.1s ease-in-out infinite;
  }

  .demo-outs {
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .demo-out {
    display: grid;
    gap: 0.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-m);
    background: rgba(250, 247, 242, 0.055);
    opacity: 0;
  }

  .demo-out[data-demo-out='0'] {
    animation: demo-out-1 12s ease infinite;
  }
  .demo-out[data-demo-out='1'] {
    animation: demo-out-2 12s ease infinite;
  }
  .demo-out[data-demo-out='2'] {
    animation: demo-out-3 12s ease infinite;
  }

  @keyframes demo-out-1 {
    0%, 6% { opacity: 0; transform: translateY(8px); }
    10%, 95% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-4px); }
  }
  @keyframes demo-out-2 {
    0%, 30% { opacity: 0; transform: translateY(8px); }
    34%, 95% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-4px); }
  }
  @keyframes demo-out-3 {
    0%, 54% { opacity: 0; transform: translateY(8px); }
    58%, 95% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: translateY(-4px); }
  }

  .demo-out-kind {
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .demo-out-text {
    font-size: var(--text-small);
    line-height: 1.5;
    font-weight: 600;
  }

  .demo-flow {
    margin-top: var(--space-4);
    text-align: center;
    font-size: var(--text-small);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .demo-out {
      animation: none;
      opacity: 1;
    }
    .demo-wave-bar {
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .demo-stage {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .demo-arrow {
      justify-self: center;
      transform: rotate(90deg);
    }
  }
</style>
