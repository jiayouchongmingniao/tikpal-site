---
import ecosystem from '../../content/ecosystem.json';
---

<section class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal" style="text-align: center; margin-inline: auto">
      <h2 class="h2">{ecosystem.title}</h2>
    </header>

    <div class="eco-flow reveal">
      <span class="eco-line" aria-hidden="true"></span>

      {
        ecosystem.forms.map((form, i) => (
          <article class="eco-form reveal" style={`--reveal-delay: ${i * 0.14}s`}>
            <span class={`eco-orb orb-${i}`} aria-hidden="true"></span>
            <p class="eco-product mono">{form.product}</p>
            <h3 class="eco-presence">{form.presence}</h3>
            <p class="eco-role">{form.role}</p>
          </article>
        ))
      }
    </div>

    <p class="eco-motif reveal">{ecosystem.motif}</p>
  </div>
</section>

<style>
  .eco-flow {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  /* the connecting current that runs through all three forms */
  .eco-line {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(250, 247, 242, 0.35) 20%,
      rgba(47, 230, 167, 0.35) 50%,
      rgba(250, 247, 242, 0.35) 80%,
      transparent
    );
    pointer-events: none;
  }

  .eco-form {
    position: relative;
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    text-align: center;
    padding: var(--space-4) var(--space-2);
    border-radius: var(--radius-l);
    background: linear-gradient(
      180deg,
      rgba(250, 247, 242, 0.05),
      rgba(250, 247, 242, 0.015)
    );
    border: 1px solid var(--line-light);
  }

  .eco-orb {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    margin-bottom: var(--space-2);
    border: 1px solid rgba(250, 247, 242, 0.3);
  }

  .orb-0 {
    background: radial-gradient(circle at 35% 30%, #3a3733, #14120f);
  }

  .orb-1 {
    background: radial-gradient(circle at 35% 30%, #efe9df, #b9b1a2);
  }

  .orb-2 {
    background: radial-gradient(circle at 35% 30%, #4a3d2c, #1c150d);
  }

  .eco-product {
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .eco-presence {
    font-size: var(--text-h4);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .eco-role {
    font-size: var(--text-small);
    opacity: 0.65;
  }

  .eco-motif {
    margin-top: var(--space-5);
    text-align: center;
    font-size: var(--text-lead);
    opacity: 0.6;
  }

  @media (max-width: 860px) {
    .eco-flow {
      grid-template-columns: 1fr;
    }

    .eco-line {
      left: 50%;
      right: auto;
      top: 6%;
      bottom: 6%;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        transparent,
        rgba(250, 247, 242, 0.35) 20%,
        rgba(47, 230, 167, 0.35) 50%,
        rgba(250, 247, 242, 0.35) 80%,
        transparent
      );
    }
  }
</style>
