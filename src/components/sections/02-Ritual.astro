---
import ritual from '../../content/ritual.json';
---

<section id="ritual" class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{ritual.title}</h2>
      <p class="lead">{ritual.subtitle}</p>
    </header>

    <ol class="ritual-steps">
      <!-- 01 Press -->
      <li class="ritual-step reveal" style="--reveal-delay: 0.05s">
        <div class="step-visual step-press" aria-hidden="true">
          <svg viewBox="0 0 200 140" fill="none">
            <rect x="62" y="18" width="76" height="112" rx="26" stroke="rgba(250,247,242,0.35)" stroke-width="1.5" fill="rgba(250,247,242,0.03)"></rect>
            <circle cx="100" cy="74" r="20" stroke="rgba(250,247,242,0.5)" stroke-width="1.5"></circle>
            <rect x="95" y="64" width="10" height="14" rx="5" fill="rgba(250,247,242,0.85)"></rect>
            <path d="M90 76 a10 10 0 0 0 20 0" stroke="rgba(250,247,242,0.6)" stroke-width="1.5" stroke-linecap="round"></path>
            <circle class="dot-alive" cx="100" cy="112" r="3.5" fill="#2FE6A7"></circle>
          </svg>
        </div>
        <p class="step-number mono">{ritual.steps[0].number}</p>
        <h3 class="step-name">{ritual.steps[0].name}</h3>
        <p class="step-detail">{ritual.steps[0].detail}</p>
      </li>

      <!-- 02 Speak -->
      <li class="ritual-step reveal" style="--reveal-delay: 0.15s">
        <div class="step-visual step-speak" aria-hidden="true">
          <p class="step-quote">“{ritual.steps[1].detail}”</p>
          <div class="wave">
            <span class="wave-bar" style="height: 10px; animation-delay: 0s"></span>
            <span class="wave-bar" style="height: 22px; animation-delay: 0.12s"></span>
            <span class="wave-bar" style="height: 34px; animation-delay: 0.24s"></span>
            <span class="wave-bar" style="height: 18px; animation-delay: 0.36s"></span>
            <span class="wave-bar" style="height: 40px; animation-delay: 0.48s"></span>
            <span class="wave-bar" style="height: 24px; animation-delay: 0.6s"></span>
            <span class="wave-bar" style="height: 32px; animation-delay: 0.72s"></span>
            <span class="wave-bar" style="height: 14px; animation-delay: 0.84s"></span>
            <span class="wave-bar" style="height: 26px; animation-delay: 0.96s"></span>
          </div>
        </div>
        <p class="step-number mono">{ritual.steps[1].number}</p>
        <h3 class="step-name">{ritual.steps[1].name}</h3>
        <p class="step-detail">Your words, as they come.</p>
      </li>

      <!-- 03 Captured -->
      <li class="ritual-step reveal" style="--reveal-delay: 0.25s">
        <div class="step-visual step-captured" aria-hidden="true">
          <svg viewBox="0 0 200 140" fill="none">
            <rect x="62" y="18" width="76" height="112" rx="26" stroke="rgba(250,247,242,0.14)" stroke-width="1.5" fill="rgba(250,247,242,0.02)"></rect>
            <circle cx="100" cy="74" r="22" stroke="#2FE6A7" stroke-width="1.5"></circle>
            <path d="M91 74 l6.5 6.5 L110 67" stroke="#2FE6A7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="fade-hint" aria-hidden="true"></span>
        </div>
        <p class="step-number mono">{ritual.steps[2].number}</p>
        <h3 class="step-name">{ritual.steps[2].name}</h3>
        <p class="step-detail">{ritual.steps[2].detail}</p>
      </li>
    </ol>

    <ul class="reassurances">
      {
        ritual.reassurances.map((line, i) => (
          <li class="reveal" style={`--reveal-delay: ${0.1 + i * 0.12}s`}>
            {line}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ritual-steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .ritual-step {
    display: grid;
    gap: 0.4rem;
    padding: var(--space-3);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: rgba(250, 247, 242, 0.025);
  }

  .step-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 9.5rem;
    border-radius: var(--radius-m);
    background: linear-gradient(
      160deg,
      rgba(250, 247, 242, 0.05),
      rgba(250, 247, 242, 0.01)
    );
    margin-bottom: var(--space-2);
    overflow: hidden;
  }

  .step-visual svg {
    width: min(200px, 80%);
    height: auto;
  }

  .step-number {
    opacity: 0.55;
  }

  .step-name {
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .step-detail {
    font-size: var(--text-small);
    opacity: 0.65;
  }

  .step-quote {
    font-size: var(--text-small);
    line-height: 1.5;
    opacity: 0.85;
    max-width: 16em;
    text-align: center;
    padding-inline: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .step-speak {
    align-content: center;
  }

  .wave {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .wave-bar {
    width: 3px;
    border-radius: 2px;
    background: var(--alive);
    display: block;
  }

  .fade-hint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 10, 10, 0.85),
      transparent 65%
    );
    pointer-events: none;
  }

  .reassurances {
    list-style: none;
    margin-top: var(--space-5);
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    text-align: center;
  }

  .reassurances li {
    font-size: var(--text-lead);
    font-weight: 500;
    opacity: 0.82;
  }

  @media (max-width: 860px) {
    .ritual-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
