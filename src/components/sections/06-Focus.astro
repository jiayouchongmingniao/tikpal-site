---
import focus from '../../content/focus.json';
---

<section class="section surface-tone">
  <div class="container focus-grid">
    <div class="focus-copy">
      <header class="section-head reveal" style="margin-bottom: var(--space-3)">
        <h2 class="h2">{focus.title}</h2>
        <p class="lead">{focus.subtitle}</p>
      </header>

      <div class="focus-modes reveal" style="--reveal-delay: 0.15s">
        {
          focus.modes.map((mode) => (
            <span class="mode-tag mono">{mode}</span>
          ))
        }
      </div>

      <p class="focus-line reveal" style="--reveal-delay: 0.25s">
        {focus.line}
      </p>
    </div>

    <div class="focus-visual reveal" style="--reveal-delay: 0.2s" aria-hidden="true">
      <div class="breath-ring ring-a"></div>
      <div class="breath-ring ring-b"></div>
      <div class="breath-core">
        <span class="dot-alive"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .focus-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .focus-modes {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .mode-tag {
    padding: 0.5rem 1.3rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    background: var(--white);
  }

  .focus-line {
    margin-top: var(--space-3);
    font-size: var(--text-lead);
    opacity: 0.6;
  }

  .focus-visual {
    position: relative;
    height: 18rem;
    display: grid;
    place-items: center;
  }

  .breath-ring {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(10, 10, 10, 0.14);
  }

  .ring-a {
    width: 14rem;
    height: 14rem;
    animation: breathScale 6s ease-in-out infinite;
  }

  .ring-b {
    width: 10rem;
    height: 10rem;
    animation: breathScale 6s ease-in-out infinite 0.6s;
  }

  .breath-core {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: var(--white);
    border: 1px solid var(--line-dark);
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-lift);
  }

  @keyframes breathScale {
    0%,
    100% {
      transform: scale(0.94);
      opacity: 0.4;
    }
    50% {
      transform: scale(1.06);
      opacity: 1;
    }
  }

  @media (max-width: 860px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }

    .focus-visual {
      height: 14rem;
    }
  }
</style>
