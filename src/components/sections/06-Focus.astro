---
import focus from '../../content/focus.json';
---

<section class="section surface-tone">
  <div class="container focus-grid">
    <div class="focus-copy">
      <header class="section-head reveal" style="margin-bottom: var(--space-3)">
        <h2 class="h2">{focus.title}</h2>
        <p class="lead">{focus.subtitle}</p>
      </header>

      <div class="focus-modes reveal" style="--reveal-delay: 0.15s">
        {
          focus.modes.map((mode) => (
            <span class="mode-tag mono">{mode}</span>
          ))
        }
      </div>

      <p class="focus-line reveal" style="--reveal-delay: 0.25s">
        {focus.line}
      </p>
    </div>

    <figure class="focus-visual reveal" style="--reveal-delay: 0.2s">
      <img
        src="/images/voice/focus-1.avif"
        alt="Tikpal in focus mode — a calm interface, nothing asking for attention"
        width="640"
        height="360"
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .focus-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .focus-modes {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .mode-tag {
    padding: 0.5rem 1.3rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-pill);
    font-size: var(--text-small);
    background: var(--white);
  }

  .focus-line {
    margin-top: var(--space-3);
    font-size: var(--text-lead);
    opacity: 0.6;
  }

  .focus-visual {
    position: relative;
    display: grid;
    place-items: center;
    margin: 0;
  }

  .focus-visual img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    border: 1px solid var(--line-dark);
    box-shadow: var(--shadow-lift);
  }

  @media (max-width: 860px) {
    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
