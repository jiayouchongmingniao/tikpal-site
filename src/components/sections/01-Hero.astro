---
import hero from '../../content/hero.json';
---

<section id="voice" class="hero section surface-dark grain">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow mono reveal">{hero.eyebrow}</p>
      <h1 class="h1 reveal" style="--reveal-delay: 0.08s">
        {hero.titleLine1}<br />
        <span class="hero-line-2">{hero.titleLine2}</span>
      </h1>
      <p class="lead reveal" style="--reveal-delay: 0.18s">{hero.subtitle}</p>

      <div class="hero-actions reveal" style="--reveal-delay: 0.28s">
        <a
          class="btn btn-solid"
          href={hero.primaryCta.href}
          target="_blank"
          rel="noopener">{hero.primaryCta.label}</a
        >
        <a class="link-arrow" href={hero.secondaryCta.href}>
          {hero.secondaryCta.label}
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <p class="hero-footnote mono reveal" style="--reveal-delay: 0.38s">
        {hero.footnote}
      </p>
    </div>

    <figure class="hero-device reveal" style="--reveal-delay: 0.15s">
      <picture>
        <source media="(max-width: 767px)" srcset="/images/voice/hero-mobile.avif" />
        <source type="image/webp" srcset="/images/voice/hero-desktop.webp" />
        <img
          class="hero-img"
          src="/images/voice/hero-desktop.png"
          alt="Tikpal Voice resting in an open palm — a pocket-sized AI voice companion"
          width="1672"
          height="941"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <figcaption class="hero-status mono">
        <span class="dot-alive" aria-hidden="true"></span>
        Ready to capture
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--section-pad) + 2rem);
  }

  .hero-glow {
    position: absolute;
    right: -10%;
    top: 10%;
    width: 55vw;
    height: 55vw;
    max-width: 52rem;
    max-height: 52rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(120, 112, 100, 0.22) 0%,
      rgba(47, 230, 167, 0.05) 45%,
      transparent 70%
    );
    animation: drift 11s ease-in-out infinite;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 40fr 60fr;
    gap: var(--space-4);
    align-items: center;
    position: relative;
  }

  .hero-copy {
    display: grid;
    gap: var(--space-3);
    align-content: center;
  }

  .hero-line-2 {
    color: var(--tone-400);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-1);
  }

  .hero-footnote {
    margin-top: var(--space-3);
    opacity: 0.55;
  }

  .hero-device {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    position: relative;
    margin: 0;
  }

  .hero-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    opacity: 0.7;
    font-size: var(--text-micro);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: 0;
      padding-top: 7rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    /* mobile simplification: device first, copy after — product understood in view one */
    .hero-device {
      order: -1;
    }

    .hero-img {
      max-width: 22rem;
      border-radius: var(--radius-m);
    }

    .hero-footnote {
      margin-top: var(--space-2);
    }
  }
</style>
