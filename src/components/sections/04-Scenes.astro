---
import scenes from '../../content/scenes.json';

// Real "bring everywhere" photography, matched per scene.
const scenePhotos = [
  {
    src: '/images/voice/carry-4.avif',
    alt: 'Tikpal mounted on bicycle handlebars, ready while moving',
  },
  {
    src: '/images/voice/carry-1.avif',
    alt: 'Tikpal clipped beside sheet music on a tablet, capturing while you play',
  },
  {
    src: '/images/voice/carry-5.avif',
    alt: 'Tikpal worn on a wrist through an ordinary day',
  },
];
---

<section class="section surface-tone">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{scenes.title}</h2>
    </header>

    <div class="scene-grid">
      {
        scenes.cards.map((card, i) => (
          <article
            class="scene-card reveal"
            style={`--reveal-delay: ${i * 0.12}s`}
          >
            <div class="scene-art">
              <img
                src={scenePhotos[i].src}
                alt={scenePhotos[i].alt}
                width="467"
                height="305"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="scene-name mono">{card.name}</p>
            <h3 class="scene-headline">{card.headline}</h3>
            <p class="scene-body">{card.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scene-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .scene-card {
    display: grid;
    gap: 0.5rem;
    padding: var(--space-2);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--line-dark);
    transition: transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) ease;
  }

  .scene-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lift);
  }

  .scene-art {
    border-radius: var(--radius-m);
    overflow: hidden;
    aspect-ratio: 467 / 305;
    background: var(--tone-200);
  }

  .scene-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .scene-name {
    margin-top: var(--space-2);
    opacity: 0.55;
    text-transform: uppercase;
    letter-spacing: 0.14em;
  }

  .scene-headline {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .scene-body {
    font-size: var(--text-small);
    opacity: 0.68;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .scene-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
