---
import privacy from '../../content/privacy.json';
---

<section id="approach" class="section surface-tone">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{privacy.title}</h2>
      <p class="lead">{privacy.subtitle}</p>
    </header>

    <div class="privacy-grid">
      {
        privacy.points.map((point, i) => (
          <article class="privacy-point reveal" style={`--reveal-delay: ${i * 0.12}s`}>
            <span class="privacy-icon" aria-hidden="true">
              {i === 0 && (
                <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                  <circle cx="16" cy="16" r="9" stroke="currentColor" stroke-width="1.6"></circle>
                  <circle cx="16" cy="16" r="3.2" fill="#2FE6A7"></circle>
                </svg>
              )}
              {i === 1 && (
                <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                  <rect x="8" y="13" width="16" height="12" rx="3" stroke="currentColor" stroke-width="1.6"></rect>
                  <path d="M12 13 v-3 a4 4 0 0 1 8 0 v3" stroke="currentColor" stroke-width="1.6"></path>
                  <circle cx="16" cy="19" r="1.8" fill="currentColor"></circle>
                </svg>
              )}
              {i === 2 && (
                <svg viewBox="0 0 32 32" width="26" height="26" fill="none">
                  <path d="M16 5 l10 4 v7 c0 6 -4.5 9.5 -10 11 c-5.5 -1.5 -10 -5 -10 -11 v-7 z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
                  <path d="M12 16 l3 3 l5.5 -6" stroke="#2FE6A7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
                </svg>
              )}
            </span>
            <h3 class="privacy-name">{point.name}</h3>
            <p class="privacy-body">{point.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .privacy-point {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: var(--space-3);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--line-dark);
  }

  .privacy-icon {
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: 1px solid var(--line-dark);
    color: var(--black);
    margin-bottom: var(--space-1);
  }

  .privacy-name {
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .privacy-body {
    font-size: var(--text-small);
    opacity: 0.68;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .privacy-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
