---
import app from '../../content/app.json';
---

<section id="app" class="section surface-warm app-section">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow mono">{app.eyebrow}</p>
      <h2 class="h2">{app.title}</h2>
      <p class="lead">{app.subtitle}</p>
      <div>
        <a class="btn btn-dark" href={app.cta.href}>{app.cta.label}</a>
      </div>
    </header>

    <div class="app-grid">
      <!-- Left: one day of captures -->
      <div class="app-timeline card reveal">
        <p class="timeline-label mono">{app.timeline.label}</p>
        <ol>
          {
            app.timeline.entries.map((entry, i) => (
              <li class="timeline-row" style={`--reveal-delay: ${0.1 + i * 0.1}s`}>
                <span class="tl-time mono">{entry.time}</span>
                <span class="tl-line" aria-hidden="true"></span>
                <span class="tl-kind">{entry.kind}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <!-- Right: AI summary card -->
      <div class="app-summary card reveal" style="--reveal-delay: 0.15s">
        <div class="summary-head">
          <h3 class="summary-title">{app.summaryCard.title}</h3>
          <span class="summary-meta mono">{app.summaryCard.meta}</span>
        </div>
        <dl class="summary-body">
          <div class="summary-row">
            <dt class="mono">{app.summaryCard.coreIdea.label}</dt>
            <dd>{app.summaryCard.coreIdea.text}</dd>
          </div>
          <div class="summary-row">
            <dt class="mono">{app.summaryCard.next.label}</dt>
            <dd>{app.summaryCard.next.text}</dd>
          </div>
        </dl>
        <span class="summary-dot dot-alive" aria-hidden="true"></span>
      </div>
    </div>

    <div class="app-actions reveal">
      {
        app.actions.map((action, i) => (
          <p class="app-action" style={`--reveal-delay: ${i * 0.1}s`}>
            {action}
          </p>
        ))
      }
    </div>

    <p class="app-closing mono reveal">{app.closing}</p>
  </div>
</section>

<style>
  .app-section {
    background: linear-gradient(180deg, var(--white) 0%, var(--tone-100) 100%);
  }

  .app-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-3);
    align-items: stretch;
  }

  .app-timeline {
    padding: var(--space-3);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .timeline-label {
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .app-timeline ol {
    list-style: none;
    display: grid;
  }

  .timeline-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line-dark);
  }

  .timeline-row:last-child {
    border-bottom: none;
  }

  .tl-time {
    opacity: 0.55;
    flex: none;
    width: 3.6em;
  }

  .tl-line {
    width: 1.4rem;
    height: 1px;
    background: var(--tone-300);
    flex: none;
  }

  .tl-kind {
    font-weight: 550;
  }

  .app-summary {
    padding: var(--space-3);
    display: grid;
    gap: var(--space-2);
    align-content: start;
    position: relative;
    background: linear-gradient(160deg, var(--white), var(--tone-100));
  }

  .summary-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .summary-title {
    font-size: var(--text-h4);
    font-weight: 600;
  }

  .summary-meta {
    opacity: 0.5;
  }

  .summary-body {
    display: grid;
    gap: var(--space-2);
  }

  .summary-row {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-2);
    border-radius: var(--radius-s);
    background: rgba(250, 247, 242, 0.7);
    border: 1px solid var(--line-dark);
  }

  .summary-row dt {
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--text-micro);
  }

  .summary-row dd {
    font-size: var(--text-body);
  }

  .summary-dot {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .app-actions {
    margin-top: var(--space-4);
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 6vw, 5rem);
  }

  .app-action {
    font-size: var(--text-h4);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
  }

  .app-closing {
    margin-top: var(--space-3);
    text-align: center;
    opacity: 0.5;
  }

  @media (max-width: 860px) {
    .app-grid {
      grid-template-columns: 1fr;
    }

    .app-actions {
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }
  }
</style>
