---
import type { HomeFaq } from '../home/types';

interface Props {
  content: HomeFaq;
}

const { content: faq } = Astro.props;
---

<section id="faq" class="section surface-warm">
  <div class="container container-narrow">
    <header class="section-head reveal">
      <h2 class="h2">{faq.title}</h2>
    </header>

    <div class="faq-list reveal" style="--reveal-delay: 0.12s">
      {
        faq.items.map((item) => (
          <details class="faq-item">
            <summary class="faq-q">{item.q}</summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>

    <p class="faq-more reveal" style="--reveal-delay: 0.2s">
      <a class="link-arrow" href={faq.moreLink.href}>
        {faq.moreLink.label} <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>
</section>

<style>
  .container-narrow {
    max-width: 46rem;
  }

  .faq-list {
    display: grid;
    gap: 0.8rem;
  }

  .faq-item {
    border: 1px solid var(--line-dark);
    border-radius: var(--radius-m);
    background: rgba(10, 10, 10, 0.02);
    padding: 0 1.2rem;
  }

  .faq-q {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    font-size: var(--text-body);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q::after {
    content: "+";
    font-size: var(--text-h4);
    font-weight: 400;
    opacity: 0.45;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-q::after {
    transform: rotate(45deg);
  }

  .faq-a {
    margin: 0;
    padding: 0 0 1.1rem;
    font-size: var(--text-small);
    line-height: 1.7;
    opacity: 0.72;
    max-width: 38rem;
  }

  .faq-more {
    margin-top: var(--space-4);
    text-align: center;
  }

  .faq-more .link-arrow {
    color: inherit;
    text-decoration: none;
  }
</style>
