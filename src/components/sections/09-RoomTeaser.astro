---
import room from '../../content/room.json';
---

<section id="room" class="section surface-room grain">
  <div class="room-bg" aria-hidden="true"></div>
  <div class="room-glow" aria-hidden="true"></div>

  <div class="container">
    <div class="room-state reveal">
      <div class="state-band">
        <img
          class="state-img state-img-a"
          src="/images/room/state-listen.webp"
          alt="Tikpal Room interface in Listen state"
          width="1280"
          height="360"
          loading="lazy"
          decoding="async"
        />
        <img
          class="state-img state-img-b"
          src="/images/room/state-unwind.webp"
          alt="Tikpal Room interface in Unwind state"
          width="1280"
          height="360"
          loading="lazy"
          decoding="async"
          aria-hidden="true"
        />
      </div>
      <div class="state-labels mono">
        <span class="state-label state-label-a">{room.states[0].mode}</span>
        <span class="state-label state-label-b" aria-hidden="true"
          >{room.states[1].mode}</span
        >
        <span class="state-dot dot-alive" aria-hidden="true"></span>
      </div>
    </div>

    <div class="room-copy">
      <p class="eyebrow mono reveal">{room.title}</p>
      <h2 class="h2 reveal" style="--reveal-delay: 0.1s">{room.headline}</h2>
      <p class="lead reveal" style="--reveal-delay: 0.2s">{room.subtitle}</p>
      <div class="reveal" style="--reveal-delay: 0.3s">
        <a class="btn btn-ghost" href={room.cta.href}>
          {room.cta.label}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .surface-room {
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .room-bg {
    position: absolute;
    inset: 0;
    background: url('/images/room/living-room.webp') center / cover no-repeat;
    opacity: 0.08;
    pointer-events: none;
  }

  .room-glow {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 60vw;
    height: 60vw;
    max-width: 46rem;
    max-height: 46rem;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(214, 164, 96, 0.14) 0%,
      rgba(120, 80, 40, 0.06) 45%,
      transparent 70%
    );
    animation: drift 12s ease-in-out infinite;
    pointer-events: none;
  }

  .room-state {
    position: relative;
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    margin-bottom: var(--space-5);
  }

  .state-band {
    position: relative;
    width: 100%;
    aspect-ratio: 2560 / 720;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--tone-200);
    box-shadow: var(--shadow-soft);
  }

  .state-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .state-img-a {
    animation: stateFade 9s ease-in-out infinite;
  }

  .state-img-b {
    opacity: 0;
    animation: stateFadeAlt 9s ease-in-out infinite;
  }

  @keyframes stateFade {
    0%,
    42% {
      opacity: 1;
    }
    50%,
    92% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  @keyframes stateFadeAlt {
    0%,
    42% {
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  .state-labels {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: var(--text-micro);
    opacity: 0.7;
  }

  .state-label {
    grid-area: 1 / 1;
  }

  .state-labels {
    display: inline-grid;
    grid-auto-flow: column;
    align-items: center;
  }

  .state-label-a {
    animation: stateFade 9s ease-in-out infinite;
  }

  .state-label-b {
    animation: stateFadeAlt 9s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .state-img-b,
    .state-label-b {
      animation: none;
      opacity: 0;
    }

    .state-img-a,
    .state-label-a {
      animation: none;
      opacity: 1;
    }
  }

  .room-copy {
    display: grid;
    gap: var(--space-2);
    justify-items: center;
    position: relative;
  }

  .room-copy .lead {
    max-width: 30em;
  }

  .room-copy .btn {
    margin-top: var(--space-2);
  }
</style>
