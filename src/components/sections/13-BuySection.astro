---
import buy from '../../content/buy.json';
---

<section id="shop" class="section surface-warm">
  <div class="container">
    <div class="buy-grid">
      <div class="buy-copy">
        <header class="section-head reveal" style="margin-bottom: var(--space-3)">
          <h2 class="h2">{buy.title}</h2>
        </header>

        <div class="buy-product reveal" style="--reveal-delay: 0.1s">
          <p class="buy-name">{buy.productName}</p>
          <p class="buy-price">
            <span class="price-value mono">{buy.price}</span>
            <span class="price-note">{buy.priceNote}</span>
          </p>
        </div>

        <dl class="buy-details">
          {
            buy.details.map((detail, i) => (
              <div class="buy-detail reveal" style={`--reveal-delay: ${0.15 + i * 0.08}s`}>
                <dt>{detail.name}</dt>
                <dd>{detail.body}</dd>
              </div>
            ))
          }
        </dl>

        <div class="buy-actions reveal" style="--reveal-delay: 0.4s">
          <a class="btn btn-dark" href={buy.primaryCta.href}>
            {buy.primaryCta.label}
          </a>
          <a class="link-arrow" href={buy.secondaryCta.href}>
            {buy.secondaryCta.label}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="buy-visual reveal" style="--reveal-delay: 0.2s" aria-hidden="true">
        <svg viewBox="0 0 420 480" fill="none" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="buyBg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f1ece3"></stop>
              <stop offset="1" stop-color="#e0d9ca"></stop>
            </linearGradient>
            <linearGradient id="buyBody" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#2b2926"></stop>
              <stop offset="1" stop-color="#131110"></stop>
            </linearGradient>
          </defs>
          <rect width="420" height="480" rx="28" fill="url(#buyBg)"></rect>
          <circle cx="210" cy="238" r="150" stroke="rgba(10,10,10,0.1)" stroke-width="1"></circle>
          <circle cx="210" cy="238" r="180" stroke="rgba(10,10,10,0.06)" stroke-width="1"></circle>

          <!-- device, laid on a dock -->
          <rect x="140" y="118" width="140" height="220" rx="44" fill="url(#buyBody)"></rect>
          <rect x="140" y="118" width="140" height="220" rx="44" stroke="rgba(250,247,242,0.25)" stroke-width="1"></rect>
          <g fill="rgba(250,247,242,0.35)">
            <circle cx="196" cy="172" r="2"></circle><circle cx="210" cy="172" r="2"></circle><circle cx="224" cy="172" r="2"></circle>
            <circle cx="189" cy="186" r="2"></circle><circle cx="203" cy="186" r="2"></circle><circle cx="217" cy="186" r="2"></circle><circle cx="231" cy="186" r="2"></circle>
            <circle cx="196" cy="200" r="2"></circle><circle cx="210" cy="200" r="2"></circle><circle cx="224" cy="200" r="2"></circle>
          </g>
          <circle cx="210" cy="258" r="34" stroke="rgba(250,247,242,0.2)" stroke-width="1.4"></circle>
          <rect x="204" y="244" width="12" height="18" rx="6" fill="rgba(250,247,242,0.85)"></rect>
          <path d="M199 258 a11 11 0 0 0 22 0" stroke="rgba(250,247,242,0.6)" stroke-width="1.5" stroke-linecap="round"></path>
          <circle cx="210" cy="312" r="4" fill="#2FE6A7"></circle>

          <!-- dock -->
          <path d="M116 372 h188 a10 10 0 0 1 10 10 v6 h-208 v-6 a10 10 0 0 1 10 -10 z" fill="#32302c" opacity="0.9"></path>
          <text x="210" y="430" text-anchor="middle" fill="rgba(10,10,10,0.45)" font-size="11" letter-spacing="4" font-family="system-ui, sans-serif">TIKPAL VOICE</text>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .buy-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-5);
    align-items: center;
  }

  .buy-product {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line-dark);
  }

  .buy-name {
    font-size: var(--text-h4);
    font-weight: 650;
  }

  .buy-price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.8rem;
  }

  .price-value {
    font-size: var(--text-h4);
    font-weight: 650;
    padding: 0.15em 0.6em;
    border: 1px dashed var(--tone-400);
    border-radius: var(--radius-s);
  }

  .price-note {
    font-size: var(--text-small);
    opacity: 0.55;
  }

  .buy-details {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }

  .buy-detail {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
  }

  .buy-detail dt {
    font-weight: 600;
    font-size: var(--text-small);
  }

  .buy-detail dd {
    font-size: var(--text-small);
    opacity: 0.62;
    line-height: 1.55;
  }

  .buy-actions {
    margin-top: var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .buy-visual svg {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 860px) {
    .buy-grid {
      grid-template-columns: 1fr;
    }

    .buy-detail {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
