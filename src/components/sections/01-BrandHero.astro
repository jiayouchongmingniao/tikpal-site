---
import type { Brand } from '../home/types';

interface Props {
  content: Brand;
}

const { content: brand } = Astro.props;
---

<section id="tikpal" class="brand section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <p class="eyebrow mono">{brand.eyebrow}</p>
      <h1 class="h1">{brand.title}</h1>
      <p class="lead">{brand.subtitle}</p>
    </header>

    <div class="brand-flow reveal" style="--reveal-delay: 0.15s">
      <span class="brand-flow-line" aria-hidden="true"></span>
      <div class="brand-products">
        {
          brand.products.map((product, i) => (
            <a class="brand-card reveal" href={product.href} style={`--reveal-delay: ${0.2 + i * 0.12}s`}>
              <p class="brand-name mono">{product.name}</p>
              <p class="brand-verb">{product.verb}</p>
              <p class="brand-line">{product.line}</p>
            </a>
          ))
        }
      </div>
    </div>

    <p class="brand-explore reveal" style="--reveal-delay: 0.5s">
      <a class="link-arrow" href={brand.exploreCta.href}>
        {brand.exploreCta.label}
        <span class="arrow" aria-hidden="true">↓</span>
      </a>
    </p>
  </div>
</section>

<style>
  .brand {
    min-height: 72svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--section-pad) + 1rem);
  }

  .brand .section-head {
    max-width: 46rem;
  }

  .brand h1 {
    font-size: clamp(2.2rem, 1.2rem + 2.6vw, 3.4rem);
    line-height: 1.1;
  }

  .brand-flow {
    position: relative;
    margin-top: var(--space-3);
  }

  /* weak context-flow line behind the three product cards */
  .brand-flow-line {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 50%;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(250, 247, 242, 0.18) 20%,
      rgba(250, 247, 242, 0.18) 80%,
      transparent
    );
    pointer-events: none;
  }

  .brand-products {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .brand-card {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding: var(--space-3) 1.2rem;
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(4px);
    min-height: 7.5rem;
    color: inherit;
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) ease;
  }

  .brand-card:hover {
    transform: translateY(-6px);
    border-color: rgba(250, 247, 242, 0.3);
  }

  .brand-name {
    font-size: var(--text-micro);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .brand-verb {
    font-size: var(--text-h4);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    color: var(--tone-400);
  }

  .brand-line {
    font-size: var(--text-small);
    line-height: 1.6;
    opacity: 0.72;
  }

  .brand-explore {
    margin-top: var(--space-3);
    text-align: center;
  }

  @media (max-width: 860px) {
    .brand {
      min-height: 0;
      padding-top: 7rem;
    }

    .brand-products {
      grid-template-columns: 1fr;
    }

    .brand-card {
      min-height: 0;
    }

    .brand-flow-line {
      display: none;
    }
  }
</style>
