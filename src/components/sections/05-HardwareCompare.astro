---
import hardware from '../../content/hardware.json';
---

<section class="section surface-dark grain">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="h2">{hardware.title}</h2>
      <p class="lead">{hardware.subtitle}</p>
    </header>

    <div class="compare">
      <!-- Phone: six steps, heavy -->
      <div class="compare-col compare-phone reveal">
        <p class="compare-label mono">{hardware.phone.label}</p>
        <img
          class="compare-img"
          src="/images/voice/compare-phone.avif"
          alt="A phone screen crowded with apps between you and the moment"
          width="489"
          height="358"
          loading="lazy"
          decoding="async"
        />
        <ol class="compare-steps">
          {
            hardware.phone.steps.map((step, i) => (
              <li class="compare-step step-heavy">
                <span class="step-index mono">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <div class="compare-divider reveal" aria-hidden="true">
        <span class="mono">vs</span>
      </div>

      <!-- Tikpal: three steps, light -->
      <div class="compare-col compare-tikpal reveal" style="--reveal-delay: 0.15s">
        <p class="compare-label mono">{hardware.tikpal.label}</p>
        <img
          class="compare-img"
          src="/images/voice/hands-on.png"
          alt="Tikpal Voice held in two hands — press, speak, done"
          width="1920"
          height="1080"
          loading="lazy"
          decoding="async"
        />
        <ol class="compare-steps">
          {
            hardware.tikpal.steps.map((step, i) => (
              <li class="compare-step step-light">
                <span class="step-index mono">{String(i + 1).padStart(2, '0')}</span>
                <span>{step}</span>
                {i === hardware.tikpal.steps.length - 1 && (
                  <span class="dot-alive" aria-hidden="true"></span>
                )}
              </li>
            ))
          }
        </ol>
        <p class="compare-note mono">That's all.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .compare {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-3);
    align-items: start;
  }

  .compare-col {
    display: grid;
    gap: var(--space-2);
  }

  .compare-label {
    opacity: 0.55;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .compare-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-light);
    opacity: 0.92;
  }

  .compare-tikpal .compare-img {
    opacity: 1;
  }

  .compare-steps {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .compare-step {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-m);
    font-size: var(--text-small);
  }

  .step-index {
    opacity: 0.4;
    flex: none;
  }

  .step-heavy {
    background: rgba(250, 247, 242, 0.06);
    border: 1px solid var(--line-light);
    opacity: 0.75;
  }

  .step-light {
    background: rgba(250, 247, 242, 0.1);
    border: 1px solid rgba(250, 247, 242, 0.24);
    font-weight: 550;
    opacity: 1;
  }

  .step-light .dot-alive {
    margin-left: auto;
    flex: none;
  }

  .compare-divider {
    align-self: center;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    opacity: 0.6;
  }

  .compare-note {
    opacity: 0.55;
  }

  @media (max-width: 860px) {
    .compare {
      grid-template-columns: 1fr;
    }

    .compare-divider {
      margin-inline: auto;
    }
  }
</style>
