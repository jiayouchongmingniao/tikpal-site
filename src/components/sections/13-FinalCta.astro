---
import type { FinalCta } from '../home/types';

interface Props {
  content: FinalCta;
}

const { content: finalCta } = Astro.props;

const IMG_VER = '?v3';
---

<section id="shop" class="section surface-warm">
  <div class="container">
    <div class="final-grid">
      <div class="final-copy reveal">
        <h2 class="h2">{finalCta.title}</h2>
        <p class="final-subtitle">{finalCta.subtitle}</p>

        <p class="final-price-row">
          <span class="final-product mono">{finalCta.productName}</span>
          <span class="final-price">{finalCta.price}</span>
        </p>

        <a
          class="btn btn-dark"
          href={finalCta.primaryCta.href}
          target="_blank"
          rel="noopener"
        >
          {finalCta.primaryCta.label}
        </a>

        <ul class="final-trust mono">
          {
            finalCta.trustPoints.map((point) => (
              <li class="final-trust-item">
                <span class="final-check" aria-hidden="true">✓</span>
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="final-figure reveal" style="--reveal-delay: 0.15s">
        <picture>
          <source type="image/avif" srcset={'/images/buy-product.avif' + IMG_VER} />
          <img
            src={'/images/buy-product.webp' + IMG_VER}
            alt={finalCta.productName}
            width="1080"
            height="608"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </figure>
    </div>
  </div>
</section>

<style>
  .final-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-4);
    align-items: center;
  }

  .final-copy {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .final-subtitle {
    font-size: var(--text-h4);
    font-weight: 500;
    opacity: 0.72;
    letter-spacing: var(--tracking-tight);
  }

  .final-price-row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-top: var(--space-2);
  }

  .final-product {
    font-size: var(--text-small);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .final-price {
    font-size: clamp(2.4rem, 1.6rem + 2.4vw, 3.4rem);
    font-weight: 650;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .final-copy .btn {
    margin-top: var(--space-2);
  }

  .final-trust {
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    max-width: 30rem;
  }

  .final-trust-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-micro);
    letter-spacing: 0.06em;
    opacity: 0.68;
  }

  .final-check {
    color: var(--alive);
    opacity: 1;
    font-size: 0.85em;
  }

  .final-figure {
    margin: 0;
  }

  .final-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    box-shadow: var(--shadow-soft);
  }

  @media (max-width: 860px) {
    .final-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
