---
import reviews from '../../content/reviews.json';
---

<section class="section surface-dark grain">
  <div class="container">
    <div class="reviews-grid">
      {
        reviews.reviews.map((review, i) => (
          <figure class="review-card reveal" style={`--reveal-delay: ${i * 0.12}s`}>
            <svg class="review-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path
                d="M4 13 c0 -4 2.5 -7 6 -8 l0.8 1.6 c-2 1 -3.2 2.6 -3.4 4.4 c0.2 -0.1 0.5 -0.1 0.8 -0.1 c1.8 0 3 1.3 3 3 c0 1.8 -1.3 3.1 -3.1 3.1 c-2.3 0 -4.1 -1.7 -4.1 -4 z m9 0 c0 -4 2.5 -7 6 -8 l0.8 1.6 c-2 1 -3.2 2.6 -3.4 4.4 c0.2 -0.1 0.5 -0.1 0.8 -0.1 c1.8 0 3 1.3 3 3 c0 1.8 -1.3 3.1 -3.1 3.1 c-2.3 0 -4.1 -1.7 -4.1 -4 z"
                fill="currentColor"
              ></path>
            </svg>
            <blockquote class="review-quote">{review.quote}</blockquote>
            <figcaption class="review-role mono">{review.role}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }

  .review-card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    padding: var(--space-4) var(--space-3);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-l);
    background: linear-gradient(
      175deg,
      rgba(250, 247, 242, 0.055),
      rgba(250, 247, 242, 0.015)
    );
  }

  .review-mark {
    color: var(--tone-400);
  }

  .review-quote {
    font-size: var(--text-lead);
    line-height: 1.45;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
  }

  .review-role {
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  @media (max-width: 860px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
