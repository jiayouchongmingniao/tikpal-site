# Cloudflare Pages custom headers
# Hashed build assets are immutable — cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Images are long-lived (paths change on content swap) — cache 7 days at edge.
/images/*
  Cache-Control: public, max-age=604800
/og.png
  Cache-Control: public, max-age=604800
